# ═══════════════════════════════════════════════════════════════════
# SEASON RESERVAS - Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# FLASK Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# DATABASE Configuration
# For development (local PostgreSQL): postgresql://localhost/season_dev
# For production (Supabase PostgreSQL):
#   postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://localhost/season_dev

# WhatsApp / Twilio Configuration (Optional)
WHATSAPP_NUMBER=689135630
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Shift Times
TURNO_COMIDA_INICIO=13:00
TURNO_COMIDA_FIN=16:00
TURNO_CENA_INICIO=20:00
TURNO_CENA_FIN=23:30

# Logging
LOG_LEVEL=INFO
